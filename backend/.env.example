# ============================================================
# FIKRA AI — Backend Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---------- Application ----------
APP_NAME="FIKRA AI"
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_64

# ---------- Groq LLM ----------
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_CONCURRENT_REQUESTS=10
# Approximate USD pricing per million tokens, used only for analytics cost
# estimates. Update these when you change Groq models.
GROQ_INPUT_COST_PER_MILLION_USD=0.10
GROQ_OUTPUT_COST_PER_MILLION_USD=0.50

# ---------- Database (local development) ----------
# For local PostgreSQL:
# The password lives only in backend/.env (never committed). Use an obvious
# placeholder here so real credentials never leak into the example file.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_local_db_password@localhost:5432/rag-prod
DATABASE_SSL=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# ---------- Database (Neon / cloud) ----------
# Replace the values below with your Neon connection string.
# IMPORTANT: asyncpg requires ssl= in connect_args, not in the URL.
# Set DATABASE_SSL=true — do NOT add ?sslmode=require to the URL.
#
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb
# DATABASE_SSL=true
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1

# ---------- JWT ----------
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
# Local development:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production (add your Vercel frontend URL):
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ---------- Embeddings ----------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=true

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=20
RERANKER_TOP_N=5
MIN_RELEVANCE_SCORE=0.3
RAG_RETRIEVAL_CANDIDATES=12

# ---------- Upload / Documents ----------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,odt,pptx,odp,xlsx,xls,ods,csv,tsv,md,markdown,html,htm,txt,rtf,png,jpg,jpeg,webp,bmp,tif,tiff
UPLOAD_DIR=./uploads

# ---------- Workers ----------
WORKER_CONCURRENCY=4
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ---------- Token budgets ----------
MAX_INPUT_TOKENS=6000
MAX_OUTPUT_TOKENS=2048
MAX_CONTEXT_MESSAGES=20
SUMMARIZE_AFTER_MESSAGES=30
# RAG prompt budget. Keep requests small on Groq's free tier so rapid
# follow-up questions do not hit the provider's tokens-per-minute limit.
RAG_CONTEXT_MAX_PASSAGES=5
RAG_CONTEXT_CHARS_PER_PASSAGE=600
RAG_HISTORY_MAX_MESSAGES=6
RAG_HISTORY_MAX_TOKENS=600
RAG_PROMPT_MAX_TOKENS=2200
RAG_ANSWER_MAX_TOKENS=1024

# ---------- Rate limits ----------
# RATE_LIMIT_ENABLED=false disables enforcement (tests / local debugging).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_PASSWORD_RESET=5/hour

# ---------- Public sign-up ----------
# Comma-separated org IDs that accept self-registration. Membership in any
# other organization must be provisioned by an admin.
PUBLIC_SIGNUP_ORG_IDS=00000000-0000-0000-0000-000000000001

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- Email (optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@fikra.ai
